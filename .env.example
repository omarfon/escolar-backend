PORT=3000
NODE_ENV=development

# ── CORS (desarrollo y producción) ──
# URL principal del frontend (se agrega automáticamente a orígenes permitidos)
# URL del frontend (enlaces de recuperación de contraseña)
# FRONTEND_URL=https://royal-escolar.rsdev.site
# FRONTEND_URL=http://localhost:4200

# Orígenes explícitos (separados por coma). Soporta comodín: https://*.rsdev.site
# CORS_ORIGINS=https://royal-escolar.rsdev.site,https://www.royal-escolar.rsdev.site
# CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Patrones adicionales (opcional, separados por coma)
# CORS_ORIGIN_PATTERNS=https://*.rsdev.site,https://*.tudominio.com

# CORS_ORIGINS=*                          # cualquier origen (solo pruebas; no usar con credentials en prod)

# En producción: false por defecto. Activar solo si necesitas acceso LAN/local
# CORS_ALLOW_LAN=true
# CORS_ALLOW_LOCALHOST=true

DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=escolar

# ── Almacenamiento de documentos ──
# local = carpeta uploads/ (desarrollo) | minio = object storage S3-compatible
STORAGE_DRIVER=local
# STORAGE_DRIVER=minio
# MINIO_ENDPOINT=127.0.0.1
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=escolar-documents
# MINIO_REGION=us-east-1
# Consola MinIO: http://localhost:9001 (minioadmin / minioadmin)

# Días de retención de la bitácora de accesos (purge automático)
# AUDIT_LOG_RETENTION_DAYS=15

# Notificar por correo cambios en datos personales del estudiante
# NOTIFY_SENSITIVE_STUDENT_CHANGES=true

# ── Correo SMTP (editar aquí para cambiar cuenta o proveedor) ──
# Gmail: MAIL_PASS = contraseña de aplicación Google (16 caracteres)
# SendGrid: SMTP_HOST=smtp.sendgrid.net, MAIL_USER=apikey, MAIL_PASS=<API Key SG...>
#   MAIL_FROM debe ser EXACTAMENTE un remitente verificado en SendGrid (Sender Identity).
#   Ver: https://sendgrid.com/docs/for-developers/sending-email/sender-identity/
# Desarrollo sin contraseña: MAIL_DEV_FALLBACK=ethereal (vista previa web, no llega al buzón)
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_USER=magentadin@gmail.com
MAIL_PASS=
MAIL_FROM=magentadin@gmail.com
MAIL_FROM_NAME=Portal Escolar
MAIL_REPLY_TO=magentadin@gmail.com
MAIL_TEST_TO=magentadin@gmail.com
MAIL_DEV_FALLBACK=ethereal
