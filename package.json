{
  "name": "escolar-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:db": "npm run db:up && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:up": "powershell -ExecutionPolicy Bypass -File scripts/db-up.ps1",
    "db:reset": "powershell -ExecutionPolicy Bypass -File scripts/db-reset.ps1",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:wait": "node scripts/wait-for-postgres.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:academic-data": "ts-node scripts/load-academic-data.ts",
    "db:docentes-data": "ts-node scripts/load-docentes-data.ts",
    "db:asistencia-data": "ts-node scripts/load-asistencia-control-data.ts",
    "db:sedes-data": "ts-node scripts/load-sedes-data.ts",
    "db:bitacora-data": "ts-node scripts/load-bitacora-data.ts",
    "db:registro-notas-data": "ts-node scripts/load-registro-notas-data.ts",
    "db:horarios-data": "ts-node scripts/load-horarios-data.ts",
    "db:dedupe-students": "ts-node scripts/load-dedupe-students-data.ts",
    "db:seed": "ts-node scripts/load-database-seed.ts",
    "db:demo-student": "ts-node scripts/load-demo-student.ts",
    "db:demo-student-catalog": "ts-node scripts/load-demo-student-catalog.ts",
    "db:events-data": "ts-node scripts/load-events-data.ts",
    "db:entregas-data": "ts-node scripts/load-entregas-data.ts",
    "db:parent-links": "ts-node scripts/load-parent-links.ts",
    "db:student-profiles": "ts-node scripts/load-student-profiles.ts",
    "db:student-documents": "ts-node scripts/load-student-documents.ts",
    "db:treasury-concepts-data": "ts-node scripts/load-treasury-concepts-data.ts",
    "db:treasury-data": "ts-node scripts/load-treasury-data.ts",
    "db:temario-data": "ts-node scripts/load-temario-data.ts",
    "db:promedios-data": "ts-node scripts/load-promedios-data.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
